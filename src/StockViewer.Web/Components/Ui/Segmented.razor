@* Port of components/ui/segmented.tsx: a small group of toggle buttons where exactly one is pressed. *@
@typeparam TValue

<div role="group" aria-label="@Label" class="segmented @(Disabled ? "segmented-disabled" : null) @Class">
    @foreach (var option in Options)
    {
        var pressed = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
        <button @key="option.Label"
                type="button"
                aria-pressed="@(pressed ? "true" : "false")"
                disabled="@Disabled"
                @onclick="() => Select(option.Value)">
            @if (option.Icon is { } icon)
            {
                <Icons Name="icon" />
            }
            @option.Label
        </button>
    }
</div>

@code {
    /// <summary>Accessible name of the group.</summary>
    [Parameter, EditorRequired] public required string Label { get; set; }

    [Parameter, EditorRequired] public required IReadOnlyList<SegmentedOption<TValue>> Options { get; set; }

    [Parameter] public TValue? Value { get; set; }

    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Class { get; set; }

    private Task Select(TValue value) => ValueChanged.InvokeAsync(value);
}
