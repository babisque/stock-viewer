@* The few icons the app needs, as inline SVG (paths from Lucide, ISC licence). Always decorative: the button or
   text next to them carries the meaning. *@
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" class="icon @Class" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case IconName.Plus:
            <path d="M5 12h14" /><path d="M12 5v14" />
            break;
        case IconName.Refresh:
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" />
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" />
            break;
        case IconName.Pencil:
            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
            <path d="m15 5 4 4" />
            break;
        case IconName.Trash:
            <path d="M3 6h18" /><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" /><path d="M10 11v6" /><path d="M14 11v6" />
            break;
        case IconName.History:
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" />
            break;
        case IconName.Sun:
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" />
            <path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
            break;
        case IconName.Moon:
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            break;
        case IconName.Monitor:
            <rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" />
            break;
        case IconName.ArrowUp:
            <path d="m5 12 7-7 7 7" /><path d="M12 19V5" />
            break;
        case IconName.ArrowDown:
            <path d="M12 5v14" /><path d="m19 12-7 7-7-7" />
            break;
        case IconName.ArrowUpDown:
            <path d="m21 16-4 4-4-4" /><path d="M17 20V4" /><path d="m3 8 4-4 4 4" /><path d="M7 4v16" />
            break;
        case IconName.Warning:
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" /><path d="M12 17h.01" />
            break;
        case IconName.X:
            <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public IconName Name { get; set; }

    [Parameter] public string? Class { get; set; }
}
