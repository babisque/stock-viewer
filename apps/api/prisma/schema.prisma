generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Market {
  B3
  US
}

enum TransactionType {
  BUY
  SELL
}

model Position {
  id           String        @id @default(cuid())
  ticker       String // uppercase, no suffix: "PETR4", "AAPL"
  market       Market
  // Derived from the transactions and rewritten on every change; the API
  // reads the transactions, these columns mirror the result.
  quantity     Decimal // Decimal allows fractional US shares
  averagePrice Decimal // in the market's currency
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@unique([ticker, market])
}

model Transaction {
  id         String          @id @default(cuid())
  positionId String
  position   Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  type       TransactionType
  date       DateTime // trade date at UTC midnight
  quantity   Decimal
  unitPrice  Decimal // in the position's currency
  fees       Decimal         @default(0)
  createdAt  DateTime        @default(now())

  @@index([positionId, date])
}
